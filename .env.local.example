# Copy to .env.local for local dev, or add the same keys in Vercel → Settings → Environment Variables.
# Never commit real values to git.

# --- Supabase (Postgres connection string) ---
# Supabase Dashboard → Project Settings → Database → Connection string → URI → Transaction pooler
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- App / Vercel ---
# Local: http://localhost:3000
# Production: your Vercel URL (or omit — VERCEL_URL is used automatically on Vercel)
APP_URL=http://localhost:3000

# Random long string for session cookies (generate once, use same value on Vercel)
SESSION_SECRET=generate-a-long-random-string

# --- Google Drive OAuth ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional — defaults to APP_URL + /api/integrations/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Local seed only (npm run db:seed) — not needed on Vercel after first setup ---
SEED_ADMIN_PASSWORD=choose-a-strong-password
SEED_ADMIN_USERNAME=admin
