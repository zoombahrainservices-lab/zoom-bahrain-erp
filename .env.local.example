# Copy to .env.local for local dev, or add the same keys in Vercel → Settings → Environment Variables.
# Never commit real values to git.

# --- Supabase: Postgres (Drizzle ORM — required) ---
# Dashboard → Project Settings → Database → Connection string → URI → Transaction pooler
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Supabase: API keys (required) ---
# Dashboard → Project Settings → API → Project URL + anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only — never expose in frontend (Dashboard → API → service_role / secret key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App / Vercel ---
APP_URL=http://localhost:3000
SESSION_SECRET=generate-a-long-random-string

# --- Google Drive OAuth (later) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local seed only (not needed on Vercel) ---
SEED_ADMIN_PASSWORD=choose-a-strong-password
SEED_ADMIN_USERNAME=admin
